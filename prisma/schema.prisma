generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cars {
  id             Int             @id @default(autoincrement())
  brand          String          @db.VarChar(50)
  model_name     String          @db.VarChar(100)
  version_name   String?         @db.VarChar(80)
  gear_count     Int?
  seats          Int?
  year           Int?
  engine         String?         @db.VarChar(20)
  color          String?         @db.VarChar(50)
  image_url      String?         @default("")
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  r8_locality    String?         @db.VarChar(120)
  models         models          @relation(fields: [model_name], references: [name], map: "cars_model_name_fk")
  versions       versions?       @relation(fields: [model_name, version_name], references: [model_name, name], map: "cars_model_version_name")
  rn8_localities rn8_localities? @relation(fields: [r8_locality], references: [locality_name], onDelete: Restrict, map: "cars_r8_locality_fk")
}

model models {
  id                                   Int        @id @default(autoincrement())
  name                                 String     @unique @db.VarChar(100)
  brand                                String?    @db.VarChar(255)
  cars                                 cars[]
  versions_versions_model_idTomodels   versions[] @relation("versions_model_idTomodels")
  versions_versions_model_nameTomodels versions[] @relation("versions_model_nameTomodels")
}

model project_description {
  id                        Int     @id @default(autoincrement())
  all_around_description    String  @unique
  backend                   String
  frontend                  String
  testing                   String  @db.VarChar(80)
  url_repository            String? @unique @db.VarChar(70)
  name                      String? @db.VarChar(70)
  devops                    String
  swagger_documentation_url String? @unique @db.VarChar(80)
}

model rn8_localities {
  id              Int     @id @default(autoincrement())
  province        String  @db.VarChar(80)
  locality_name   String  @unique @db.VarChar(120)
  normalized_name String  @db.VarChar(120)
  is_active       Boolean @default(true)
  cars            cars[]

  @@unique([province, normalized_name])
}

model versions {
  id                                 Int     @id @default(autoincrement())
  model_id                           Int
  model_name                         String  @db.VarChar(100)
  name                               String  @db.VarChar(80)
  brand                              String? @db.VarChar(255)
  cars                               cars[]
  models_versions_model_idTomodels   models  @relation("versions_model_idTomodels", fields: [model_id], references: [id])
  models_versions_model_nameTomodels models  @relation("versions_model_nameTomodels", fields: [model_name], references: [name])

  @@unique([model_id, name], map: "versions_unique_per_model_id")
  @@unique([model_name, name], map: "versions_unique_per_model_name")
}
